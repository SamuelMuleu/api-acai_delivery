# PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/acai?schema=public

# Login do painel administrativo (POST /auth/login)
ADMIN_PASSWORD=troque-esta-senha
# Segredo para assinar os tokens (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ADMIN_TOKEN_SECRET=

# Upload de imagens dos produtos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcionais
PORT=3333
CORS_ORIGIN=https://acai-delivery.vercel.app,http://localhost:5173
