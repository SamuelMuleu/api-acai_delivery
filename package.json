{
  "name": "acaiteria-backend",
  "version": "1.1.0",
  "description": "API REST de uma açaiteria: cardápio, pedidos e painel administrativo (Express 5, Prisma e PostgreSQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/api.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "cloudinary": "^2.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "prisma": "^6.8.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.21",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "embedded-postgres": "^17.2.0-beta.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
